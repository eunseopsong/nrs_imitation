+    assert list(tmp_path.iterdir()) == []
+    for original in c['rtc_pose_conditioning']['reference_C_runs']:
+        archived = json.loads(Path(original['config']).read_text())
+        assert executor_settings(c, 'il') == executor_settings(archived, 'il')
