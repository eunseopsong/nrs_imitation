<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>stain_relative_frame</name>
  <version>0.1.0</version>
  <description>
    Stain-centred TCP frame: home-pose repeatability check, pixel-to-robot
    homography calibration, stain-origin detection, dataset relativisation and
    the pre-training shortcut-leakage gate. Removes absolute TCP position as a
    shortcut for predicting the defect type.
  </description>

  <maintainer email="lexondms1@g.skku.edu">eunseop</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-h5py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <!-- PTP / mode service used by the home-pose repeatability node.
       Optional at runtime: the node falls back to manual-move mode. -->
  <exec_depend>y2_rob_motion_interfaces</exec_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
